{
	"name": "@build-script/create-wrapper-script",
	"type": "module",
	"version": "0.0.2",
	"bin": {
		"create-wrapper-script": "./loader/bin.devel.js"
	},
	"exports": {
		".": {
			"types": "./src/create-wrap-script.ts",
			"source": "./src/create-wrap-script.ts",
			"default": "./lib/create-wrap-script.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepublishHook": "internal-prepublish-hook",
		"prepack": "mpis-run build --clean",
		"build": "mpis-run build",
		"watch": "mpis-run watch",
		"clean": "mpis-run clean",
		"lint": "internal-lint",
		"prepublishOnly": "internal-prepublish-deny"
	},
	"dependencies": {
		"@idlebox/logger": "workspace:^",
		"@idlebox/args": "workspace:^",
		"@idlebox/common": "workspace:^",
		"@idlebox/node": "workspace:^",
		"@idlebox/shebang-parse": "workspace:^",
		"split-cmd": "^1.1.0"
	},
	"devDependencies": {
		"@build-script/monorepo-lib": "workspace:^",
		"@internal/local-rig": "workspace:^",
		"@types/node": "^26.1.2",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"packCommand": ["publisher", "pack"]
	},
	"sideEffects": false
