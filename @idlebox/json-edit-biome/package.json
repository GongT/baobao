{
	"name": "@idlebox/json-edit-biome",
	"type": "module",
	"version": "0.0.18",
	"description": "biomejs formatter for @idlebox/json-edit.",
	"keywords": ["comment", "edit", "json", "jsonc"],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"source": "./src/index.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"scripts": {
		"prepublishHook": "internal-prepublish-hook",
		"prepack": "mpis-run build --clean",
		"build": "mpis-run build",
		"watch": "mpis-run watch",
		"clean": "mpis-run clean",
		"lint": "internal-lint",
		"prepublishOnly": "internal-prepublish-deny"
	},
	"dependencies": {
		"@idlebox/common": "workspace:~",
		"@idlebox/json-extends-loader": "workspace:~",
		"@idlebox/node": "workspace:~",
		"@idlebox/package-bin": "workspace:~",
		"execa": "^10.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "*",
		"@biomejs/js-api": "*",
		"@biomejs/wasm-nodejs": "*",
		"@idlebox/json-edit": "workspace:~",
		"@internal/local-rig": "workspace:~",
		"@types/node": "^26.6.3"
	},
	"decoupledDependencies": ["@idlebox/json-edit"],
	"peerDependencies": {
		"@biomejs/biome": "*",
		"@biomejs/js-api": "*",
		"@biomejs/wasm-nodejs": "*"
	},
	"peerDependenciesMeta": {
		"@biomejs/biome": {
			"optional": true
		},
		"@biomejs/js-api": {
			"optional": true
		},
		"@biomejs/wasm-nodejs": {
			"optional": true
		}
	},
	"publishConfig": {
		"packCommand": ["publisher", "pack"]
	}
}
