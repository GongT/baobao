{
	"name": "@idlebox/shebang-parse",
	"type": "module",
	"version": "0.0.1",
	"description": "A parser for shebang line in script files",
	"exports": {
		".": {
			"source": "./src/node.ts",
			"types": "./lib/node.d.ts",
			"node": "./lib/node.js",
			"default": "./lib/index.js"
		},
		"./node": "./lib/node.js",
		"./web": "./lib/index.js",
		"./package.json": "./package.json"
	},
	"imports": {
		"#manpage": {
			"early-loader": "./src/manpage.devel.ts",
			"default": "./lib/manpage.generated.js"
		}
	},
	"scripts": {
		"prepublishHook": "internal-prepublish-hook",
		"prepack": "mpis-run build --clean",
		"build": "mpis-run build",
		"watch": "mpis-run watch",
		"clean": "mpis-run clean",
		"lint": "internal-lint",
		"test": "vitest src",
		"prepublishOnly": "internal-prepublish-deny"
	},
	"dependencies": {
		"split-cmd": "^1.1.0"
	},
	"devDependencies": {
		"@internal/local-rig": "workspace:^",
		"@types/node": "^26.1.2",
		"execa": "^10.0.1",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"packCommand": ["publisher", "pack"]
	},
	"sideEffects": false
}
